---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-panel glass glass-sheen">
			<div class="footer-brand">
				<a class="brand-mark" href="/" aria-label={SITE_TITLE}>T</a>
				<p class="brand-name">{SITE_TITLE}</p>
				<p class="brand-desc">{SITE_DESCRIPTION}</p>
			</div>

			<div class="footer-col">
				<p class="col-title">导航</p>
				<a href="/">首页</a>
				<a href="/blog">文章</a>
				<a href="/software">软件库</a>
				<a href="/about">关于</a>
			</div>

			<div class="footer-col">
				<p class="col-title">订阅</p>
				<a href="/rss.xml">RSS</a>
				<a href="/sitemap-index.xml">站点地图</a>
				<a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>
			</div>

			<div class="footer-col">
				<p class="col-title">技术栈</p>
				<span>Astro</span>
				<span>Cloudflare Workers</span>
				<span>Edge Runtime</span>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} {SITE_TITLE} · Built with Astro & Cloudflare Workers</p>
			<p class="footer-note">内容仅供学习交流，转载请注明出处</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-9);
		padding: 0 var(--space-5) var(--space-6);
	}

	.footer-panel {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		gap: var(--space-6);
		padding: var(--space-6);
		border-radius: var(--radius-xl);
	}

	.footer-brand .brand-mark {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin-bottom: var(--space-3);
		border-radius: 11px;
		color: #fff;
		font-size: 1.1rem;
		font-weight: 800;
		background: linear-gradient(145deg, var(--sys-blue) 0%, var(--sys-purple) 100%);
		box-shadow:
			0 3px 10px rgba(0, 113, 227, 0.32),
			inset 0 1px 0 rgba(255, 255, 255, 0.35);
		text-decoration: none;
	}

	.brand-name {
		margin: 0 0 0.35rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--text-primary);
	}

	.brand-desc {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.col-title {
		margin: 0 0 0.35rem;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	.footer-col a,
	.footer-col span {
		font-size: 0.88rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-apple);
	}
	.footer-col a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		flex-wrap: wrap;
		padding: var(--space-5) var(--space-2) 0;
		font-size: 0.8rem;
		color: var(--text-tertiary);
	}
	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 860px) {
		.footer-panel {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-5);
			padding: var(--space-5);
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 720px) {
		.site-footer {
			padding: 0 var(--space-4) var(--space-5);
		}
		.footer-panel {
			grid-template-columns: 1fr;
			border-radius: var(--radius-lg);
		}
		.footer-bottom {
			justify-content: center;
			text-align: center;
		}
	}
</style>
