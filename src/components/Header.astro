---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="nav-shell glass glass-sheen">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">T</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<nav class="nav-links" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/software">软件库</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>

		<div class="nav-actions">
			<ThemeToggle />
			<a class="icon-btn" href="/rss.xml" target="_blank" rel="noopener" title="RSS 订阅">
				<span class="sr-only">RSS 订阅</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M2.5 10.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm-.9-4.2c-.4 0-.7.3-.7.7v2c0 .4.3.7.7.7 2.9 0 5.3 2.4 5.3 5.3 0 .4.3.7.7.7h2c.4 0 .7-.3.7-.7 0-4.8-3.9-8.7-8.7-8.7zm0-4.3c-.4 0-.7.3-.7.7v2.1c0 .4.3.7.7.7 5.3 0 9.6 4.3 9.6 9.6 0 .4-.3.7-.7.7h-2.1c-.4 0-.7-.3-.7-.7C8.9 8.8 2.6 2 1.6 2z"
					></path>
				</svg>
			</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: var(--space-4) var(--space-5);
		pointer-events: none;
	}

	.nav-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: var(--width-content);
		margin: 0 auto;
		padding: 0.55rem 0.6rem 0.55rem 0.85rem;
		border-radius: var(--radius-pill);
		background: var(--glass-bg-strong);
		box-shadow: var(--shadow-md), var(--shadow-inset);
		pointer-events: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text-primary);
		font-weight: 650;
		letter-spacing: -0.015em;
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 9px;
		color: #fff;
		font-size: 0.95rem;
		font-weight: 800;
		background: linear-gradient(145deg, var(--sys-blue) 0%, var(--sys-purple) 100%);
		box-shadow:
			0 2px 8px rgba(0, 113, 227, 0.35),
			inset 0 1px 0 rgba(255, 255, 255, 0.35);
		transition: transform var(--dur-base) var(--ease-out);
	}
	.brand:hover .brand-mark {
		transform: rotate(-8deg) scale(1.08);
	}

	.brand-text {
		font-size: 0.95rem;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.icon-btn {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		color: var(--text-secondary);
		background: var(--glass-bg-soft);
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		box-shadow: var(--shadow-sm), var(--shadow-inset);
		transition:
			color var(--dur-fast) var(--ease-apple),
			transform var(--dur-fast) var(--ease-out);
	}
	.icon-btn:hover {
		color: var(--accent);
		transform: scale(1.08);
	}

	@media (max-width: 720px) {
		.site-header {
			padding: var(--space-3) var(--space-4);
		}
		.nav-shell {
			padding: 0.4rem 0.45rem 0.4rem 0.7rem;
			gap: var(--space-2);
		}
		.brand-text {
			display: none;
		}
		.icon-btn {
			display: none;
		}
	}

	/* 窄屏下导航项文字被压得竖排，收紧内边距保证单行显示 */
	@media (max-width: 460px) {
		.nav-links {
			gap: 0;
		}
		.nav-links :global(a) {
			padding: 0.42rem 0.55rem;
			font-size: 0.82rem;
			white-space: nowrap;
		}
	}
</style>
