---
/**
 * 明暗主题切换按钮
 * - 状态持久化在 localStorage('theme')
 * - 未手动选择过时跟随系统 prefers-color-scheme
 * - 同步其他标签页的切换
 */
---

<button
	id="theme-toggle"
	class="theme-toggle"
	type="button"
	aria-label="切换深色模式"
	title="切换深色模式"
>
	<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<g
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="4.2"></circle>
			<path
				d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6L6 18M18 6l1.6-1.6"
			></path>
		</g>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path
			fill="currentColor"
			d="M20.7 14.6A8.7 8.7 0 0 1 9.4 3.3a.8.8 0 0 0-1-1 10 10 0 1 0 13.3 13.3.8.8 0 0 0-1-1Z"
		></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		position: relative;
		width: 38px;
		height: 38px;
		padding: 0;
		cursor: pointer;
		color: var(--text-primary);
		background: var(--glass-bg-soft);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		box-shadow: var(--shadow-sm), var(--shadow-inset);
		transition:
			transform var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-apple),
			box-shadow var(--dur-base) var(--ease-out);
	}
	.theme-toggle:hover {
		transform: scale(1.08);
		box-shadow: var(--shadow-md), var(--shadow-inset);
	}
	.theme-toggle:active {
		transform: scale(0.92);
	}

	.theme-toggle svg {
		position: absolute;
		transition:
			opacity var(--dur-base) var(--ease-apple),
			transform var(--dur-base) var(--ease-out);
	}

	.icon-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	.icon-moon {
		opacity: 0;
		transform: rotate(-70deg) scale(0.5);
	}

	:global(html[data-theme='dark']) .theme-toggle .icon-sun {
		opacity: 0;
		transform: rotate(70deg) scale(0.5);
	}
	:global(html[data-theme='dark']) .theme-toggle .icon-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
</style>

<script>
	function applyTheme(theme: string, persist: boolean) {
		document.documentElement.setAttribute('data-theme', theme);
		const btn = document.getElementById('theme-toggle');
		if (btn) {
			btn.setAttribute('aria-label', theme === 'dark' ? '切换浅色模式' : '切换深色模式');
		}
		if (persist) {
			try {
				localStorage.setItem('theme', theme);
			} catch (e) {
				/* 隐私模式下忽略 */
			}
		}
	}

	const toggle = document.getElementById('theme-toggle');
	if (toggle) {
		// 同步初始状态下的无障碍标签
		const current = document.documentElement.getAttribute('data-theme') || 'light';
		toggle.setAttribute('aria-label', current === 'dark' ? '切换浅色模式' : '切换深色模式');

		toggle.addEventListener('click', () => {
			const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			applyTheme(next, true);
		});
	}

	// 多标签页同步
	window.addEventListener('storage', (e) => {
		if (e.key === 'theme' && e.newValue) {
			applyTheme(e.newValue, false);
		}
	});
</script>
